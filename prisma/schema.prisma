// Prisma schema for the ShafaQ Atelier abaya store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String
  role          String     @default("customer") // customer | admin
  loyaltyPoints Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  pointTransactions PointTransaction[]
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String   // Daily Wear | New Arrivals | Best Sellers
  price         Int
  originalPrice Int?
  image         String
  images        String   @default("[]") // JSON array of image URLs (multiple images; image field is primary/first)
  colorImages   String   @default("[]") // JSON array of {colorHex, colorName, image} — real photos per color
  colors        String   // JSON array of {hex,name}
  sizes         String   // JSON array of strings
  rating        Float    @default(4.8)
  reviewCount   Int      @default(0)
  stock         Int      @default(50)
  lowStockThreshold Int  @default(5)
  active        Boolean  @default(true) // admin can hide from storefront
  isNewArrival  Boolean  @default(false) // admin can feature in New Arrivals section
  isBestSeller  Boolean  @default(false) // admin can feature in Best Sellers section
  isFeatured    Boolean  @default(false) // admin can feature in Daily Wear / featured section
  badge         String?
  fabric        String
  care          String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]
  wishlistItems WishlistItem[]
  @@index([category])
}

model Order {
  id          String   @id @default(cuid())
  number      String   @unique // human-friendly LM-XXXXXXXX
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  email       String
  fullName    String
  phone       String
  address     String
  city        String
  province    String
  postal      String
  notes       String?
  payment     String   // cod | bank_transfer | online
  paymentStatus String @default("pending") // pending | paid | failed | refunded
  paymentProvider  String? // jazzcash | bank_transfer | easypaisa | stripe | etc.
  paymentReference String? // customer-supplied transaction/reference ID (for manual bank transfer) or gateway transaction ref
  paymentScreenshotPath String? // optional uploaded screenshot path (admin-only view) — null if not used
  paidAt      DateTime?
  paymentFailureReason String?
  paymentVerifiedById String? // admin user id who verified/rejected the payment (audit)
  paymentVerifiedAt DateTime?
  subtotal    Int
  discount    Int      @default(0)
  shipping    Int
  total       Int
  promoCode   String?
  status      String   @default("processing") // processing | shipped | delivered | cancelled
  clientToken String?  // unique token to prevent duplicate submissions
  createdAt   DateTime @default(now())
  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  image     String
  price     Int
  qty       Int
  color     String
  colorName String
  size      String
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int      // 1-5
  title       String
  body        String
  verified    Boolean  @default(false) // true if author has purchased the product
  helpful     Int      @default(0)
  adminReply  String?
  adminReplyAt DateTime?
  createdAt   DateTime @default(now())

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model GiftCard {
  id          String   @id @default(cuid())
  code        String   @unique // LMGC-XXXXXXXX
  amount      Int      // face value in PKR
  balance     Int      // remaining balance
  buyerEmail  String?
  buyerName   String?
  recipientEmail String
  recipientName  String
  message     String?
  status      String   @default("active") // active | redeemed | expired
  orderId     String?  // linked purchase order
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([recipientEmail])
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int      // positive = earned, negative = redeemed
  type        String   // earned | redeemed | adjusted
  description String
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Singleton row (id = "default") holding editable store configuration.
// Sensitive payment credentials (JazzCash gateway API keys, Integrity Salt) remain
// in environment variables and are never stored here. The fields below are
// business-facing payment instructions (JazzCash mobile number, bank account
// details) shown to customers during checkout for MANUAL bank transfer.
model StoreSettings {
  id                  String   @id @default("default")
  businessName        String   @default("ShafaQ Atelier")
  businessAddress     String   @default("M.A. Jinnah Road, Okara, Punjab, Pakistan")
  businessEmail       String   @default("hello@shafaqatelier.pk")
  businessPhone       String   @default("+92 300 1234567")
  businessWhatsapp    String   @default("+92 300 1234567")
  shippingCharge      Int      @default(350)
  freeShippingThreshold Int    @default(10000)
  lowStockThreshold   Int      @default(5)
  storeOpen           Boolean  @default(true)
  announcement        String?
  // Manual bank transfer payment instructions (shown to customer at checkout)
  jazzCashNumber      String   @default("03256912201")
  bankName            String   @default("Raqmi Islamic Digital Bank")
  bankAccountNumber   String   @default("028846199786")
  bankAccountTitle    String   @default("ShafaQ Atelier")
  manualTransferEnabled Boolean @default(true)
  codEnabled          Boolean  @default(true)
  // Customized Abaya base price — admin can change at any time; customer-side
  // price calculation uses this as the starting point before fabric/add-on prices.
  customAbayaBasePrice Int     @default(15000)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Dynamic catalog configuration models (admin-managed, no code changes needed)
// ---------------------------------------------------------------------------

// Color palette — supports 100+ colors. Used by both regular products (via the
// colors JSON on Product) and the Customized Abaya builder. Admin can add/edit/
// deactivate colors. Inactive colors are hidden from customers.
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  hex       String   // HEX color code, e.g. "#1a1a1a"
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fabric / Stuff for the Customized Abaya builder. Each fabric has an additional
// price that is added to the base price. themeValue is a HEX color used for
// subtle visual theming on the customer-side builder when the fabric is selected.
model Fabric {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String   @default("")
  additionalPrice Int      @default(0) // added to base price
  themeValue      String   @default("") // HEX for subtle fabric theme accent
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Customization options / add-ons for the Customized Abaya builder. Admin can
// create any add-on (sleeves, hijab, embroidery, details, etc.) with a price.
// optionType groups add-ons in the UI (e.g. "sleeves", "hijab", "embroidery").
model CustomizationOption {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  optionType      String   @default("addon") // sleeves | hijab | embroidery | details | style | addon
  additionalPrice Int      @default(0)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([optionType])
}

// Abaya Style — represents a customizable abaya silhouette (e.g. "Classic Open
// Abaya", "Kimono / Flared"). Each style has multiple preview images (front,
// back, left, right, detail) managed by admin. When a customer selects a style
// in the Customized Abaya builder, the preview gallery shows these images.
model AbayaStyle {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String        @default("")
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  images      AbayaImage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Abaya Image — a single preview image for an AbayaStyle. Supports multiple
// angles (front, back, left, right, detail). Optional colorHex links an image
// to a specific color so the preview changes when the customer selects that
// color. isPrimary marks the default/hero image. sortOrder controls display
// order in the thumbnail strip.
model AbayaImage {
  id           String      @id @default(cuid())
  abayaStyleId String
  abayaStyle   AbayaStyle  @relation(fields: [abayaStyleId], references: [id], onDelete: Cascade)
  url          String
  angle        String      @default("front") // front | back | left | right | detail
  label        String      @default("") // optional display label, e.g. "Front View"
  isPrimary    Boolean     @default(false)
  colorHex     String?     // optional: if set, this image is shown when the customer selects this color
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([abayaStyleId])
  @@index([colorHex])
}
