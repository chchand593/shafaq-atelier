# ShafaQ Atelier — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control. (.env* is gitignored.)

# ---------------------------------------------------------------------------
# Database (PostgreSQL — required for Vercel/Neon production)
# ---------------------------------------------------------------------------
# Use your Neon PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?schema=public

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Production: set to your public site URL (e.g. https://shafaq-atelier.vercel.app)
NEXTAUTH_URL=https://shafaq-atelier.vercel.app

# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret-min-16-chars

# ---------------------------------------------------------------------------
# Setup Secret (one-time database setup)
# ---------------------------------------------------------------------------
# Used by /api/admin/setup?secret=YOUR_SECRET to create admin + products.
# After setup is done, REMOVE this variable to disable the route.
SETUP_SECRET=replace-with-a-strong-random-secret

# ---------------------------------------------------------------------------
# Vercel Blob (for admin image uploads)
# ---------------------------------------------------------------------------
# Get from Vercel → Settings → Storage → Blob store
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Payment Gateway — JazzCash (optional, manual transfer is default)
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true
