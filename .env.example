# ShafaQ Atelier — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control. (.env* is gitignored.)

# ---------------------------------------------------------------------------
# Database (PostgreSQL — required for Vercel/Neon production)
# ---------------------------------------------------------------------------
# Use your Neon PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?schema=public

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Production: set to your public site URL (e.g. https://shafaq-atelier.vercel.app)
NEXTAUTH_URL=https://shafaq-atelier.vercel.app

# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret-min-16-chars

# ---------------------------------------------------------------------------
# Setup Secret (one-time database setup)
# ---------------------------------------------------------------------------
# Used by /api/admin/setup?secret=YOUR_SECRET to create admin + products.
# After setup is done, REMOVE this variable to disable the route.
SETUP_SECRET=replace-with-a-strong-random-secret

# ---------------------------------------------------------------------------
# Vercel Blob (for admin image uploads)
# ---------------------------------------------------------------------------
# OPTION 1 — Vercel OIDC (recommended, no token needed in code):
#   1. Go to Vercel → your project → Storage tab → Create a Blob Store.
#   2. IMPORTANT: set the store Access to "Public" (NOT "Private").
#      Product images MUST be publicly readable so customers can view them
#      in the browser. If the store is Private, uploads will fail with:
#        "Vercel Blob: Cannot use public access on a private store.
#         The store is configured with private access."
#      Fix: Vercel dashboard → Storage → click the store → Settings →
#      Access → Public. (This does NOT delete or recreate the store.)
#   3. Connect the store to your project. Vercel auto-sets:
#        BLOB_STORE_ID        (auto, no need to copy)
#        VERCEL_OIDC_TOKEN    (auto, no need to copy)
#   The @vercel/blob SDK auto-detects these — no token is needed below.
#
# OPTION 2 — Legacy token (for non-Vercel or manual setups):
#   Copy the BLOB_READ_WRITE_TOKEN from the Vercel Blob dashboard.
#   Note: with OIDC connected (Option 1), this is NOT needed.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Payment Gateway — JazzCash (optional, manual transfer is default)
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true
