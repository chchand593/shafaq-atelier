# ShafaQ Atelier — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control. (.env* is gitignored.)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DEVELOPMENT (current): local SQLite file. Works for single-server deploys
# with persistent disk (e.g. a single VPS). NOT suitable for serverless /
# ephemeral filesystem platforms (Vercel, Netlify, Cloudflare Workers,
# Railway ephemeral, Render free tier) — they wipe the filesystem on each
# cold start, which would erase the database and all user accounts.
#
# PRODUCTION: use a managed PostgreSQL database. Update prisma/schema.prisma
# `datasource db { provider = "postgresql" }` and set DATABASE_URL to the
# connection string provided by your database host, e.g.:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Then run: bun run db:push (creates tables) and bun run db:seed (loads products).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Production: set to your public site URL (e.g. https://shafaqatelier.pk)
NEXTAUTH_URL=http://localhost:3000
# Generate a strong random secret. Example: openssl rand -base64 32
# In production, if this is missing or shorter than 16 chars, the app
# will refuse to start. NEVER use the placeholder value in production.
NEXTAUTH_SECRET=replace-with-a-strong-random-secret-min-16-chars

# ---------------------------------------------------------------------------
# Payment Gateway — JazzCash (Pakistani payment gateway)
# ---------------------------------------------------------------------------
# Leave PAYMENT_GATEWAY empty to keep online payment disabled (COD remains available).
# Set PAYMENT_GATEWAY=jazzcash to enable online payment.

# Gateway provider name
PAYMENT_GATEWAY=

# JazzCash Merchant ID (provided by JazzCash)
PAYMENT_MERCHANT_ID=

# JazzCash Password (provided by JazzCash — this is NOT the login password)
PAYMENT_API_KEY=

# JazzCash Integrity Salt (provided by JazzCash — used for HMAC signature)
PAYMENT_SECRET=

# URL where JazzCash sends payment callbacks
# For local development: http://localhost:3000/api/payments/webhook
# For production: https://yourdomain.com/api/payments/webhook
PAYMENT_RETURN_URL=http://localhost:3000/api/payments/webhook

# Webhook secret (optional — for additional request validation)
PAYMENT_WEBHOOK_SECRET=

# Set to "true" to use JazzCash sandbox environment
# Sandbox: https://sandbox.jazzcash.com.pk
# Production: https://payments.jazzcash.com.pk
PAYMENT_SANDBOX=true

# ---------------------------------------------------------------------------
# HOW TO OBTAIN CREDENTIALS
# ---------------------------------------------------------------------------
#
# 1. JazzCash Sandbox (for testing):
#    - Visit: https://sandbox.jazzcash.com.pk
#    - Register for a sandbox merchant account
#    - Obtain: Merchant ID, Password, Integrity Salt
#    - Set PAYMENT_SANDBOX=true and fill in the credentials above
#
# 2. JazzCash Production (for live payments):
#    - Visit: https://www.jazzcash.com.pk/business
#    - Apply for a merchant account
#    - After approval, obtain: Merchant ID, Password, Integrity Salt
#    - Set PAYMENT_SANDBOX=false (or remove the variable)
#    - Set PAYMENT_RETURN_URL to your production webhook URL
#
# 3. Webhook URL:
#    - The webhook endpoint is: /api/payments/webhook
#    - JazzCash will POST the payment result to this URL
#    - Ensure this URL is publicly accessible in production
#    - Configure the same URL in your JazzCash merchant dashboard
#
# 4. Testing:
#    - COD: Select "Cash on Delivery" in checkout — always works
#    - Online: Set credentials, select "Online Payment" — redirects to JazzCash
#    - After payment, JazzCash redirects back and the webhook updates the order
#
# 5. Switching gateway:
#    - Currently only JazzCash is implemented
#    - To add another gateway, create src/lib/{gateway}.ts following the jazzcash.ts pattern
#    - Update src/lib/payment.ts to detect and delegate to the new gateway

# Setup secret — used by /api/admin/setup?secret=YOUR_SECRET
# Set a strong random value. After running setup, REMOVE this to disable.
SETUP_SECRET=replace-with-a-strong-random-secret
